{
  "multipart": [
    {
      "when": { "facing": "north", "part": "head" },
      "apply": { "model": "winternightak:block/futon_head" }
    },
    {
      "when": { "facing": "north", "part": "foot" },
      "apply": { "model": "winternightak:block/futon_foot" }
    },
    {
      "when": { "facing": "east", "part": "head" },
      "apply": { "model": "winternightak:block/futon_head", "y": 90 }
    },
    {
      "when": { "facing": "east", "part": "foot" },
      "apply": { "model": "winternightak:block/futon_foot", "y": 90 }
    },
    {
      "when": { "facing": "south", "part": "head" },
      "apply": { "model": "winternightak:block/futon_head", "y": 180 }
    },
    {
      "when": { "facing": "south", "part": "foot" },
      "apply": { "model": "winternightak:block/futon_foot", "y": 180 }
    },
    {
      "when": { "facing": "west", "part": "head" },
      "apply": { "model": "winternightak:block/futon_head", "y": 270 }
    },
    {
      "when": { "facing": "west", "part": "foot" },
      "apply": { "model": "winternightak:block/futon_foot", "y": 270 }
    }
  ]
}